{% extends 'base.html.twig' %}

{% block title %}Confirmation{% endblock %}

{% block content %}
<section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-14 text-center lg:py-20">
    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-olympia-fonce to-olympia-bleu text-3xl text-white" aria-hidden="true">✓</div>
    <h1 class="mt-6 text-3xl font-bold text-olympia-bleu md:text-4xl">Votre commande est confirmée</h1>
    <p class="mt-3 text-olympia-secondaire">Vos billets sont disponibles ci-dessous et envoyés à {{ order.email }}.</p>

    <div class="mt-10 w-full space-y-5 text-left">
        {% for ticket in order.tickets %}
        <article class="card overflow-hidden" aria-label="Billet {{ ticket.code }}">
            <div class="bg-gradient-to-br from-olympia-fonce to-olympia-bleu p-6 text-white">
                <p class="text-xs uppercase tracking-wider text-olympia-dore">{{ ticket.ticketType.name }}</p>
                <p class="mt-1 text-2xl font-bold">{{ order.event.title }}</p>
                <p class="mt-1 text-sm text-olympia-sable">{{ order.event.startsAt|date('d/m/Y H:i') }} · {{ order.event.place }}</p>
            </div>
            <div class="flex items-center gap-6 p-6">
                {# Maquette de QR code : à remplacer par un QR généré à partir du code du billet #}
                <div class="grid h-24 w-24 shrink-0 grid-cols-8 gap-0.5 rounded-xl bg-white p-2 ring-1 ring-olympia-sable-fonce" aria-hidden="true">
                    {% for i in 0..63 %}
                        <span class="{{ (i * 7 + (i // 8) * 3) % 4 == 0 ? 'bg-white' : 'bg-olympia-fonce' }} rounded-[1px]"></span>
                    {% endfor %}
                </div>
                <div class="text-sm">
                    <p class="font-bold text-olympia-fonce">Code : {{ ticket.code }}</p>
                    <p class="mt-1 text-olympia-secondaire">{{ order.firstName }} {{ order.lastName }}</p>
                </div>
            </div>
        </article>
        {% endfor %}
    </div>

    <div class="mt-8 flex w-full flex-col gap-3 sm:flex-row">
        <a href="{{ path('tickets') }}" class="btn-primary flex-1">Voir mes billets</a>
        <a href="{{ path('home') }}" class="btn-accent flex-1">Retour à l'accueil</a>
    </div>
</section>
{% endblock %}
