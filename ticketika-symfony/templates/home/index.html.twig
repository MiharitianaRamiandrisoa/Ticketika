{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block content %}
<section class="hero-mesh relative isolate overflow-hidden text-white">
    <div class="mx-auto grid min-h-[86vh] max-w-7xl items-center gap-14 px-5 py-20 lg:grid-cols-12 lg:px-8">
        <div class="lg:col-span-7" data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] backdrop-blur">
                <span class="h-2 w-2 animate-pulse rounded-full bg-olympia-dore"></span> Centre Olympia · Tanjombato
            </span>
            <h1 class="mt-7 text-5xl font-bold leading-[1.02] tracking-tight md:text-7xl">
                Vivez chaque soir<br>
                <span class="text-gradient-gold">au cœur d'Olympia.</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-olympia-sable/90">
                Concerts, spectacles et animations. Choisissez votre événement et recevez votre billet dans votre espace personnel.
            </p>
            <form action="{{ path('events') }}" method="get" class="glow mt-10 flex max-w-xl items-center gap-2 rounded-full bg-white p-2">
                <label class="sr-only" for="hero-q">Rechercher un événement</label>
                <input id="hero-q" name="q" type="search" placeholder="Artiste, spectacle, lieu…" class="min-w-0 flex-1 bg-transparent px-4 py-2 text-olympia-fonce placeholder:text-olympia-secondaire focus:outline-none">
                <button type="submit" class="btn-accent !py-3">Rechercher</button>
            </form>
        </div>

        <div class="lg:col-span-5" data-carousel data-reveal>
            <div class="relative h-[540px]">
                {% for event in events|slice(0, 3) %}
                <a href="{{ path('event_show', {slug: event.slug}) }}" class="glow absolute inset-0 overflow-hidden rounded-[2rem] transition duration-700 ease-out {{ loop.first ? 'opacity-100 scale-100' : 'pointer-events-none scale-95 opacity-0' }}" data-slide>
                    <div class="absolute inset-0 {{ event.gradientClass }}"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-olympia-fonce via-olympia-fonce/50 to-transparent"></div>
                    <div class="absolute inset-x-0 bottom-0 p-8">
                        <div class="flex items-center gap-2">
                            {% if event.tag %}<span class="rounded-full bg-olympia-dore px-3 py-1 text-xs font-bold text-olympia-fonce">{{ event.tag }}</span>{% endif %}
                            <span class="text-xs font-semibold uppercase tracking-wider text-olympia-sable">{{ event.categoryLabel }}</span>
                        </div>
                        <h2 class="mt-4 text-4xl font-bold leading-tight">{{ event.title }}</h2>
                        <p class="mt-2 text-olympia-sable">{{ event.startsAt|date('d/m/Y') }} · {{ event.startsAt|date('H:i') }} · {{ event.place }}</p>
                        <p class="mt-3 text-sm font-semibold text-olympia-dore" data-countdown="{{ event.startsAt|date('c') }}"></p>
                        <div class="mt-6 flex items-center justify-between">
                            <span class="text-sm font-semibold">{% if event.minPrice == 0 %}Entrée libre{% else %}dès {{ event.minPrice|number_format(0, ',', ' ') }} Ar{% endif %}</span>
                            <span class="rounded-full bg-white px-6 py-2.5 text-sm font-bold text-olympia-fonce">Réserver</span>
                        </div>
                    </div>
                </a>
                {% else %}
                    <div class="flex h-full items-center justify-center rounded-[2rem] bg-white/10 p-8 text-center text-olympia-sable">Les prochains événements seront bientôt disponibles.</div>
                {% endfor %}
            </div>
            {% if events|length > 1 %}
            <div class="mt-6 flex justify-center gap-2" role="tablist" aria-label="Événements à la une">
                {% for event in events|slice(0, 3) %}
                <button type="button" class="h-2 w-8 rounded-full bg-white/30 transition aria-[current=true]:bg-olympia-dore" data-dot aria-label="Événement {{ loop.index }}" aria-current="{{ loop.first ? 'true' : 'false' }}"></button>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-5 pt-24 lg:px-8" aria-labelledby="ce-soir">
    <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5" data-reveal>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-olympia-sauge">Ce soir</p>
            <h2 id="ce-soir" class="mt-3 text-4xl font-bold leading-tight text-olympia-bleu md:text-5xl">Trouvez votre sortie en 30 secondes.</h2>
            <p class="mt-4 text-olympia-secondaire">Choisissez une catégorie et découvrez ce qui se passe au centre.</p>
            <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Choisir une catégorie" data-mood-group>
                <button type="button" class="chip" aria-pressed="true" data-mood-chip="all">Tout</button>
                {% for category in categories %}
                    <button type="button" class="chip" aria-pressed="false" data-mood-chip="{{ category.slug }}">{{ category.name }}</button>
                {% endfor %}
                <button type="button" class="chip !bg-olympia-dore !text-olympia-fonce" data-surprise>Surprise-moi ✦</button>
            </div>
        </div>
        <div class="lg:col-span-7" data-reveal>
            <ul class="space-y-4" data-tonight>
                {% for event in events|slice(0, 3) %}
                <li data-mood-item="{{ event.categorySlug }}">
                    <a href="{{ path('event_show', {slug: event.slug}) }}" class="group flex items-center gap-5 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-olympia-sable-fonce/40 transition duration-300 hover:-translate-y-1 hover:shadow-soft">
                        <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-2xl bg-olympia-bleu text-white"><span class="text-xl font-bold">{{ event.startsAt|date('H') }}</span><span class="text-xs">{{ event.startsAt|date('i') }}</span></div>
                        <div class="min-w-0 flex-1"><p class="truncate text-lg font-bold text-olympia-fonce">{{ event.title }}</p><p class="text-sm text-olympia-secondaire">{{ event.place }}</p><p class="mt-1 text-xs font-semibold text-olympia-sauge" data-seats>{{ event.remaining }} places restantes</p></div>
                        <span class="hidden rounded-full bg-olympia-sable px-5 py-2.5 text-sm font-bold text-olympia-bleu transition group-hover:bg-olympia-bleu group-hover:text-white sm:inline-flex">Voir</span>
                    </a>
                </li>
                {% else %}
                <li class="rounded-3xl bg-white p-8 text-olympia-secondaire">Aucun événement prévu pour le moment.</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</section>

<section class="mx-auto mt-28 max-w-7xl px-5 lg:px-8" aria-labelledby="cats">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end" data-reveal>
        <h2 id="cats" class="text-4xl font-bold text-olympia-bleu">Explorer par catégorie</h2>
        <a href="{{ path('events') }}" class="text-sm font-semibold text-olympia-bleu underline-offset-4 hover:underline">Tout voir →</a>
    </div>
    <div class="mt-10 grid auto-rows-[190px] gap-4 md:grid-cols-4">
        {% for category in categories %}
        <a href="{{ path('events', {cat: category.slug}) }}" class="group relative overflow-hidden rounded-[2rem] p-7 text-white {{ loop.first ? 'bg-gradient-to-br from-olympia-fonce to-olympia-bleu md:col-span-2 md:row-span-2' : (loop.index is even ? 'bg-olympia-dore text-olympia-fonce' : 'bg-olympia-sauge') }}" data-reveal>
            {% if loop.first %}<p class="text-xs font-semibold uppercase tracking-[0.2em] text-olympia-dore">À découvrir</p>{% endif %}
            <p class="{{ loop.first ? 'mt-3 text-4xl' : 'text-2xl' }} font-bold">{{ category.name }}</p>
            <span class="absolute bottom-7 right-7 flex h-12 w-12 items-center justify-center rounded-full bg-white text-xl text-olympia-fonce transition group-hover:translate-x-1">→</span>
        </a>
        {% else %}
        <p class="col-span-full rounded-3xl bg-white p-8 text-olympia-secondaire">Aucune catégorie active.</p>
        {% endfor %}
    </div>
</section>

<section class="mt-28" aria-labelledby="semaine">
    <div class="mx-auto flex max-w-7xl items-end justify-between px-5 lg:px-8" data-reveal>
        <div><h2 id="semaine" class="text-4xl font-bold text-olympia-bleu">À ne pas manquer</h2><p class="mt-2 text-sm text-olympia-secondaire">Faites défiler les cartes pour découvrir tous les événements.</p></div>
        <span class="hidden items-center gap-2 rounded-full bg-olympia-sable px-4 py-2 text-sm font-bold text-olympia-bleu md:inline-flex" aria-hidden="true">Glisser <span class="text-lg">↔</span></span>
    </div>
    <div class="relative">
        <div class="pointer-events-none absolute bottom-0 right-0 top-0 z-10 w-20 bg-gradient-to-l from-olympia-creme to-transparent md:w-32" aria-hidden="true"></div>
        <div class="hide-scrollbar mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-6 pr-16 lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]">
            {% for event in events %}
            <div class="w-[300px] shrink-0 snap-start sm:w-[340px]">{% include 'partials/_event_card.html.twig' %}</div>
            {% endfor %}
        </div>
        {% if events|length > 1 %}<div class="mx-auto flex max-w-7xl justify-end px-5 text-2xl font-bold text-olympia-bleu lg:px-8" aria-hidden="true">→</div>{% endif %}
    </div>
</section>

<section class="mx-auto mt-28 max-w-7xl px-5 lg:px-8" aria-labelledby="steps">
    <div class="rounded-[2.5rem] bg-white p-8 ring-1 ring-olympia-sable-fonce/40 md:p-14" data-reveal>
        <h2 id="steps" class="text-center text-3xl font-bold text-olympia-bleu md:text-4xl">Trois étapes, et vous êtes à l'intérieur.</h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
            <div><span class="text-6xl font-bold text-olympia-dore">01</span><p class="mt-4 text-xl font-bold text-olympia-bleu">Choisissez</p><p class="mt-2 text-olympia-secondaire">Sélectionnez votre événement et le nombre de places.</p></div>
            <div><span class="text-6xl font-bold text-olympia-sauge">02</span><p class="mt-4 text-xl font-bold text-olympia-bleu">Payez</p><p class="mt-2 text-olympia-secondaire">Mobile money ou carte. Le total affiché est celui que vous payez.</p></div>
            <div><span class="text-6xl font-bold text-olympia-bleu">03</span><p class="mt-4 text-xl font-bold text-olympia-bleu">Entrez</p><p class="mt-2 text-olympia-secondaire">Votre billet reste dans Mon espace. Présentez votre code à l'entrée.</p></div>
        </div>
    </div>
</section>

<section class="mx-auto mt-24 max-w-7xl px-5 lg:px-8" aria-label="Chiffres clés">
    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-[2rem] bg-olympia-bleu p-10 text-white" data-reveal><p class="text-6xl font-bold" data-count="1248">1 248</p><p class="mt-3 text-olympia-sable">billets vendus ce mois-ci</p></div>
        <div class="rounded-[2rem] bg-olympia-sable p-10 text-olympia-bleu" data-reveal><p class="text-6xl font-bold" data-count="5">5</p><p class="mt-3 text-olympia-secondaire">événements actifs au centre</p></div>
        <div class="rounded-[2rem] bg-olympia-fonce p-10 text-white" data-reveal><p class="text-6xl font-bold" data-count="2">2</p><p class="mt-3 text-olympia-sable">minutes en moyenne pour acheter</p></div>
    </div>
</section>

<section class="mx-auto mt-28 max-w-7xl px-5 lg:px-8" aria-labelledby="why">
    <h2 id="why" class="text-center text-4xl font-bold text-olympia-bleu" data-reveal>Pourquoi Ticketika</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in [
            { title: 'Billet instantané', text: 'Retrouvez vos billets dans Mon espace, sans application à installer.' },
            { title: 'Mobile money', text: 'MVola, Orange Money et Airtel Money, sans carte bancaire.' },
            { title: 'Entrée rapide', text: 'Scan du code depuis un téléphone, avec suivi des entrées.' }
        ] %}
        <div class="card p-7 transition duration-300 hover:-translate-y-1 hover:shadow-soft" data-reveal><span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-olympia-sable text-olympia-bleu">✦</span><p class="mt-5 text-lg font-bold text-olympia-bleu">{{ item.title }}</p><p class="mt-2 text-sm leading-relaxed text-olympia-secondaire">{{ item.text }}</p></div>
        {% endfor %}
    </div>
</section>

<section class="mx-auto mb-10 mt-28 max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-8 rounded-[2rem] bg-white p-10 ring-1 ring-olympia-sable-fonce/40 md:flex-row md:items-center md:p-14" data-reveal>
        <div><h2 class="text-3xl font-bold text-olympia-bleu">Ne manquez aucune soirée.</h2><p class="mt-2 text-olympia-secondaire">Les nouveautés et les offres du centre, une fois par semaine.</p></div>
        <form class="flex w-full max-w-md gap-2 rounded-full bg-olympia-sable p-2" action="#" method="post"><label class="sr-only" for="newsletter">Adresse e-mail</label><input id="newsletter" type="email" required placeholder="Votre adresse e-mail" class="min-w-0 flex-1 bg-transparent px-4 text-olympia-fonce placeholder:text-olympia-secondaire focus:outline-none"><button type="submit" class="btn-primary">S'inscrire</button></form>
    </div>
</section>
{% endblock %}
