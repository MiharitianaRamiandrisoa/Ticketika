{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block content %}
<section class="hero-mesh relative isolate overflow-hidden text-white">
    <div class="mx-auto max-w-7xl px-5 pb-16 pt-12 lg:px-8 lg:pb-20 lg:pt-16">
        <nav class="text-sm text-olympia-sable/80" aria-label="Fil d'Ariane"><a href="{{ path('events') }}" class="hover:text-white">Événements</a> <span aria-hidden="true">/</span> {{ event.categoryLabel }}</nav>
        <div class="mt-8 grid items-end gap-10 lg:grid-cols-12">
            <div class="lg:col-span-8" data-reveal>
                <div class="flex flex-wrap items-center gap-2">{% if event.tag %}<span class="rounded-full bg-olympia-dore px-3 py-1 text-xs font-bold text-olympia-fonce">{{ event.tag }}</span>{% endif %}<span class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold backdrop-blur">{{ event.categoryLabel }}</span></div>
                <h1 class="mt-5 text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">{{ event.title }}</h1>
                <p class="mt-5 text-lg text-olympia-sable/90">{{ event.startsAt|date('d/m/Y') }} · {{ event.startsAt|date('H:i') }} · {{ event.place }}</p>
            </div>
            <div class="lg:col-span-4" data-reveal>
                <p class="text-sm font-semibold text-olympia-dore">{% if event.remaining == 0 %}Complet{% elseif event.remaining <= 20 %}Plus que {{ event.remaining }} places{% else %}{{ event.remaining }} places disponibles{% endif %}</p>
                <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/20" role="img" aria-label="{{ (event.soldTickets / event.capacity * 100)|round }} % vendu"><div class="h-full rounded-full bg-olympia-dore" style="width: {{ event.capacity > 0 ? (event.soldTickets / event.capacity * 100)|round : 0 }}%"></div></div>
            </div>
        </div>
    </div>
</section>

<nav class="sticky top-16 z-30 border-b border-olympia-sable-fonce/60 bg-white/90 backdrop-blur" aria-label="Sections de l'événement">
    <ul class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-5 py-3 text-sm font-semibold lg:px-8">
        <li><a href="#infos" data-tab-link class="block whitespace-nowrap rounded-full px-4 py-2 text-olympia-secondaire aria-[current=true]:bg-olympia-bleu aria-[current=true]:text-white hover:text-olympia-bleu">Infos</a></li>
        <li><a href="#programme" data-tab-link class="block whitespace-nowrap rounded-full px-4 py-2 text-olympia-secondaire aria-[current=true]:bg-olympia-bleu aria-[current=true]:text-white hover:text-olympia-bleu">Programme</a></li>
        <li><a href="#lieu" data-tab-link class="block whitespace-nowrap rounded-full px-4 py-2 text-olympia-secondaire aria-[current=true]:bg-olympia-bleu aria-[current=true]:text-white hover:text-olympia-bleu">Lieu</a></li>
    </ul>
</nav>

<section class="mx-auto mt-10 grid max-w-7xl gap-8 px-5 pb-10 lg:grid-cols-12 lg:px-8">
    <div class="space-y-6 lg:col-span-7">
        <article id="infos" class="card scroll-mt-40 p-8" data-reveal><h2 class="text-2xl font-bold text-olympia-bleu">À propos</h2><p class="mt-4 text-lg leading-relaxed text-olympia-secondaire">{{ event.description }}</p></article>
        <article id="programme" class="card scroll-mt-40 p-8" data-reveal><h2 class="text-2xl font-bold text-olympia-bleu">Programme</h2><div class="relative mt-8 border-l-2 border-olympia-sable-fonce pl-8"><span class="absolute -left-[0.55rem] top-1 h-4 w-4 rounded-full border-4 border-white bg-olympia-dore"></span><p class="font-bold text-olympia-fonce">{{ event.startsAt|date('H:i') }} · Ouverture</p><p class="mt-1 text-sm text-olympia-secondaire">Ouverture des portes. Le détail du déroulé est communiqué par l'organisateur.</p></div></article>
        <article id="lieu" class="card scroll-mt-40 overflow-hidden" data-reveal><div class="relative h-56 bg-gradient-to-br from-olympia-sable to-olympia-sable-fonce" aria-hidden="true"><div class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-olympia-bleu text-white shadow-soft">●</div></div><div class="p-8"><h2 class="text-2xl font-bold text-olympia-bleu">{{ event.place }}</h2><p class="mt-2 text-olympia-secondaire">Centre Olympia · Tanjombato</p><p class="mt-3 text-sm text-olympia-secondaire">Accès par la galerie principale, parking du centre disponible.</p></div></article>
    </div>

    <aside class="lg:sticky lg:top-40 lg:col-span-5 lg:self-start" aria-labelledby="billets">
        <form action="{{ path('checkout', {slug: event.slug}) }}" method="get" class="glow rounded-[2rem] bg-white p-7 md:p-8" data-tickets data-reveal>
            <h2 id="billets" class="text-2xl font-bold text-olympia-bleu">Choisir vos billets</h2>
            <div class="mt-6 space-y-4">
                {% for type in event.ticketTypes %}
                <div class="rounded-2xl bg-olympia-sable p-5 transition hover:shadow-soft" data-ticket data-price="{{ type.priceAr }}">
                    <div class="flex items-start justify-between gap-3"><div><p class="font-bold text-olympia-fonce">{{ type.name }}</p><p class="text-xs text-olympia-secondaire">{{ type.note }} · {{ type.remaining }} disponibles</p></div><p class="font-bold text-olympia-bleu">{{ type.priceAr == 0 ? 'Gratuit' : (type.priceAr|number_format(0, ',', ' ') ~ ' Ar') }}</p></div>
                    <div class="mt-4 flex items-center justify-end gap-4"><button type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-lg font-bold text-olympia-bleu ring-1 ring-olympia-sable-fonce transition hover:bg-olympia-creme" data-dec aria-label="Retirer un billet {{ type.name }}">−</button><input type="number" name="qty[{{ type.id }}]" value="0" min="0" max="{{ type.remaining }}" readonly class="w-10 border-0 bg-transparent text-center text-lg font-bold" data-qty aria-label="Quantité {{ type.name }}"><button type="button" class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-lg font-bold text-olympia-bleu ring-1 ring-olympia-sable-fonce transition hover:bg-olympia-creme" data-inc aria-label="Ajouter un billet {{ type.name }}">+</button></div>
                </div>
                {% endfor %}
            </div>
            <dl class="mt-7 space-y-3 border-t border-olympia-sable-fonce pt-6 text-sm"><div class="flex justify-between text-olympia-secondaire"><dt>Billets</dt><dd data-subtotal>0 Ar</dd></div><div class="flex justify-between text-olympia-secondaire"><dt>Frais de service</dt><dd data-fee>0 Ar</dd></div><div class="flex justify-between pt-2 text-base font-bold text-olympia-bleu"><dt>Total, frais inclus</dt><dd data-total>0 Ar</dd></div></dl>
            <button type="submit" class="btn-primary mt-6 w-full !py-4 text-base disabled:cursor-not-allowed disabled:opacity-40" data-submit disabled><span data-submit-label>Choisissez vos billets</span></button>
            <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-olympia-secondaire"><span class="rounded-full bg-olympia-sable px-3 py-1">MVola</span><span class="rounded-full bg-olympia-sable px-3 py-1">Orange Money</span><span class="rounded-full bg-olympia-sable px-3 py-1">Airtel Money</span><span class="rounded-full bg-olympia-sable px-3 py-1">Carte</span></div>
            <p class="mt-4 text-center text-xs text-olympia-secondaire">Connectez-vous pour finaliser la réservation et retrouver vos billets.</p>
        </form>
    </aside>
</section>

{% if similar|length > 0 %}
<section class="mx-auto max-w-7xl px-5 pb-24 lg:px-8" aria-labelledby="similaires"><div class="flex items-end justify-between" data-reveal><h2 id="similaires" class="text-3xl font-bold text-olympia-bleu">Vous aimerez aussi</h2><a href="{{ path('events') }}" class="text-sm font-semibold text-olympia-bleu hover:underline">Tous les événements →</a></div><div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{% for event in similar %}{% include 'partials/_event_card.html.twig' %}{% endfor %}</div></section>
{% endif %}
{% endblock %}
