{% extends 'organizer/_layout.html.twig' %}

{% block title %}Scan des billets{% endblock %}

{% block organizer %}
<h1 class="text-3xl font-bold text-olympia-bleu">Scan des billets</h1>
<p class="mt-1 text-olympia-secondaire">Validez l'entrée à partir du code du billet.</p>

<div class="mt-8 grid gap-6 lg:grid-cols-5" data-scan-url="{{ path('organizer_scan_validate') }}">
    <section class="rounded-3xl bg-gradient-to-br from-olympia-fonce to-olympia-bleu p-6 text-white lg:col-span-3">
        <div class="relative mx-auto aspect-square max-w-md overflow-hidden rounded-2xl bg-olympia-fonce/60" data-viewfinder>
            <div class="absolute inset-8 rounded-2xl border-2 border-dashed border-olympia-dore/60"></div>
            <div class="absolute inset-x-8 top-1/2 h-0.5 -translate-y-1/2 bg-olympia-dore/80" data-scanline></div>
            <p class="absolute inset-x-0 bottom-4 text-center text-sm text-olympia-sable" data-scan-status aria-live="polite">Placez le QR code dans le cadre</p>
        </div>
        <div class="mt-6 flex justify-center">
            <button type="button" class="btn-accent" data-simulate-scan>Simuler un scan</button>
        </div>
        <script type="application/json" data-codes>{{ codes|json_encode|raw }}</script>
    </section>

    <section class="space-y-4 lg:col-span-2" aria-label="Statistiques">
        <div class="grid grid-cols-2 gap-3">
            <div class="card p-4"><p class="text-xs text-olympia-secondaire">Entrées</p><p class="mt-1 text-2xl font-bold text-olympia-bleu" data-stat="in">{{ stats.in }}</p></div>
            <div class="card p-4"><p class="text-xs text-olympia-secondaire">Restant</p><p class="mt-1 text-2xl font-bold text-olympia-bleu" data-stat="left">{{ stats.left }}</p></div>
        </div>
        <div class="card p-5">
            <h2 class="font-bold text-olympia-bleu">Derniers scans</h2>
            <ul class="mt-4 divide-y divide-olympia-sable-fonce/60" data-history>
                <li class="py-3 text-sm text-olympia-secondaire">Les validations apparaîtront ici.</li>
            </ul>
        </div>
    </section>
</div>
{% endblock %}
