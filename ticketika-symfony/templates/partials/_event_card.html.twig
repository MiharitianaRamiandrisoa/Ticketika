<article class="card group overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-soft"
         data-title="{{ event.title|lower }}" data-mood="{{ event.categorySlug }}" data-reveal>
    <a href="{{ path('event_show', {slug: event.slug}) }}" class="block focus:outline-none focus-visible:ring-4 focus-visible:ring-olympia-dore">
        <div class="relative m-3 mb-0 h-44 overflow-hidden rounded-2xl {{ event.gradientClass }}">
            {% if event.tag %}
                <span class="absolute left-4 top-4 rounded-full bg-olympia-dore px-3 py-1 text-xs font-semibold text-olympia-fonce">{{ event.tag }}</span>
            {% endif %}
            {% if event.remaining > 0 and event.remaining <= 20 %}
                <span class="absolute bottom-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-olympia-bleu">Plus que {{ event.remaining }} places</span>
            {% endif %}
        </div>
        <div class="p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-olympia-secondaire">{{ event.startsAt|date('d/m/Y') }} · {{ event.startsAt|date('H:i') }}</p>
            <h3 class="mt-1 text-lg font-bold text-olympia-bleu">{{ event.title }}</h3>
            <p class="text-sm text-olympia-secondaire">{{ event.place }}</p>
            <div class="mt-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-olympia-fonce">
                    {% if event.minPrice == 0 %}Gratuit{% else %}À partir de {{ event.minPrice|number_format(0, ',', ' ') }} Ar{% endif %}
                </span>
                <span class="btn-ghost !px-3 !py-2 text-xs">Voir</span>
            </div>
        </div>
    </a>
</article>
