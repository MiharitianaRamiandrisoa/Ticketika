{% set nav_categories = ticketika_categories() %}
{% set organizer = ticketika_is_organizer() %}
<header class="sticky top-0 z-40 border-b border-olympia-sable-fonce/50 bg-white/90 backdrop-blur">
    <div class="relative mx-auto flex min-h-20 max-w-screen-2xl items-center justify-between gap-4 px-5 lg:px-10">
        <a href="{{ path('home') }}" class="shrink-0 text-2xl font-bold tracking-tight text-olympia-bleu">ticketika</a>

        <nav class="absolute left-1/2 top-1/2 hidden max-w-[62%] -translate-x-1/2 -translate-y-1/2 items-center gap-1 overflow-x-auto md:flex" aria-label="Principal">
            <a href="{{ path('home') }}" class="shrink-0 whitespace-nowrap rounded-full px-5 py-3 text-base font-semibold transition hover:bg-olympia-sable">Accueil</a>
            {% for category in nav_categories %}
                <a href="{{ path('events', {cat: category.slug}) }}" class="shrink-0 whitespace-nowrap rounded-full px-5 py-3 text-base font-semibold transition hover:bg-olympia-sable">{{ category.name }}</a>
            {% endfor %}
        </nav>

        <div class="flex shrink-0 items-center gap-3">
            {% if organizer %}
                <a href="{{ path('organizer_dashboard') }}" class="hidden whitespace-nowrap rounded-full bg-olympia-bleu px-4 py-3 text-base font-semibold text-white transition hover:bg-olympia-fonce md:inline-flex">Dashboard</a>
            {% endif %}
            <a href="{{ path('account') }}" class="hidden whitespace-nowrap rounded-full px-4 py-3 text-base font-semibold text-olympia-bleu transition hover:bg-olympia-sable md:inline-flex">Mon espace</a>
            <button type="button" class="inline-flex h-11 w-11 shrink-0 flex-col items-center justify-center gap-1.5 rounded-full bg-olympia-sable md:hidden"
                    data-menu-toggle aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
                <span class="block h-0.5 w-5 bg-olympia-fonce"></span>
                <span class="block h-0.5 w-5 bg-olympia-fonce"></span>
            </button>
        </div>
    </div>

    <nav id="menu-mobile" class="hidden border-t border-olympia-sable-fonce/50 bg-white md:hidden" aria-label="Menu mobile">
        <div class="flex max-h-[75vh] flex-col overflow-y-auto p-3">
            {% if organizer %}
                <a href="{{ path('organizer_dashboard') }}" class="rounded-xl bg-olympia-bleu px-4 py-3 font-semibold text-white hover:bg-olympia-fonce">Dashboard</a>
            {% endif %}
            <a href="{{ path('account') }}" class="rounded-xl px-4 py-3 font-semibold hover:bg-olympia-sable">Mon espace</a>
            <a href="{{ path('home') }}" class="rounded-xl px-4 py-3 font-semibold hover:bg-olympia-sable">Accueil</a>
            {% for category in nav_categories %}
                <a href="{{ path('events', {cat: category.slug}) }}" class="rounded-xl px-4 py-3 font-semibold hover:bg-olympia-sable">{{ category.name }}</a>
            {% endfor %}
        </div>
    </nav>
</header>
