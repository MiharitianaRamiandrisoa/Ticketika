{% extends 'organizer/_layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block organizer %}
<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
        <h1 class="text-3xl font-bold text-olympia-bleu">Tableau de bord</h1>
        <p class="mt-1 text-olympia-secondaire">Activité de vos événements cette semaine</p>
    </div>
    <a href="{{ path('organizer_event_new') }}" class="btn-accent">+ Nouvel événement</a>
</div>

<div class="mt-8 grid grid-cols-2 gap-4 xl:grid-cols-4">
    {% for kpi in kpis %}
    <div class="card p-5" data-reveal>
        <p class="text-sm text-olympia-secondaire">{{ kpi.label }}</p>
        <p class="mt-2 text-2xl font-bold text-olympia-bleu">{{ kpi.value }}</p>
    </div>
    {% endfor %}
</div>

<div class="mt-8 grid gap-6 xl:grid-cols-5">
    <div class="card p-6 xl:col-span-3" data-reveal>
        <h2 class="font-bold text-olympia-bleu">Billets vendus sur 7 jours</h2>
        <div class="mt-8 flex h-56 items-end gap-3" role="img" aria-label="Graphique des ventes par jour">
            {% for day in week %}
            <div class="flex flex-1 flex-col items-center gap-2">
                <span class="text-xs font-semibold text-olympia-fonce">{{ day.count }}</span>
                <div class="w-full rounded-xl bg-gradient-to-t from-olympia-bleu to-olympia-sauge transition-all duration-700" style="height: {{ day.height }}%" data-bar></div>
                <span class="text-xs text-olympia-secondaire">{{ day.label }}</span>
            </div>
            {% endfor %}
        </div>
    </div>

    <div class="card p-6 xl:col-span-2" data-reveal>
        <h2 class="font-bold text-olympia-bleu">Prochains événements</h2>
        <ul class="mt-5 space-y-5">
            {% for event in upcoming %}
            {% set pct = event.capacity > 0 ? (event.soldTickets / event.capacity * 100)|round : 0 %}
            <li>
                <div class="flex items-center justify-between gap-3 text-sm">
                    <a href="{{ path('event_show', {slug: event.slug}) }}" class="truncate font-semibold hover:text-olympia-bleu hover:underline">{{ event.title }}</a>
                    <a href="{{ path('organizer_event_edit', {id: event.id}) }}" class="shrink-0 rounded-full p-2 text-olympia-bleu transition hover:bg-olympia-sable" aria-label="Modifier {{ event.title }}" title="Modifier l’événement">
                        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </a>
                    <span class="text-olympia-secondaire">{{ pct }} %</span>
                </div>
                <div class="mt-2 h-2 rounded-full bg-olympia-sable">
                    <div class="h-2 rounded-full bg-gradient-to-r from-olympia-bleu to-olympia-sauge" style="width: {{ pct }}%" data-progress></div>
                </div>
            </li>
            {% else %}
            <li class="text-sm text-olympia-secondaire">Aucun événement à venir.</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
