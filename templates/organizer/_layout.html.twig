{% extends 'base.html.twig' %}

{% block content %}
<div class="mx-auto grid max-w-7xl gap-8 px-5 py-8 lg:grid-cols-[260px_1fr] lg:px-8 lg:py-10">
    <nav class="col-span-full flex gap-2 overflow-x-auto rounded-2xl bg-white p-2 shadow-sm ring-1 ring-olympia-sable-fonce/40 lg:hidden" aria-label="Navigation organisateur">
        <a href="{{ path('organizer_dashboard') }}" class="shrink-0 rounded-xl bg-olympia-bleu px-4 py-3 text-sm font-semibold text-white">Dashboard</a>
        <a href="{{ path('organizer_event_new') }}" class="shrink-0 rounded-xl px-4 py-3 text-sm font-semibold text-olympia-bleu hover:bg-olympia-sable">Nouvel événement</a>
        <a href="{{ path('organizer_categories') }}" class="shrink-0 rounded-xl px-4 py-3 text-sm font-semibold text-olympia-bleu hover:bg-olympia-sable">Catégories</a>
        <a href="{{ path('organizer_scan') }}" class="shrink-0 rounded-xl px-4 py-3 text-sm font-semibold text-olympia-bleu hover:bg-olympia-sable">Scan</a>
        <form method="post" action="{{ path('logout') }}" class="ml-auto shrink-0">
            <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="rounded-xl px-4 py-3 text-sm font-semibold text-olympia-secondaire hover:bg-olympia-sable">Déconnexion</button>
        </form>
    </nav>
    <aside class="hidden rounded-3xl bg-gradient-to-b from-olympia-fonce to-olympia-bleu p-5 text-white lg:sticky lg:top-24 lg:block lg:h-fit" aria-label="Espace organisateur">
        <p class="px-3 text-xs font-semibold uppercase tracking-[0.2em] text-olympia-dore">Organisateur</p>
        <nav class="mt-6 space-y-1 text-sm">
            <a href="{{ path('organizer_dashboard') }}" class="block rounded-xl px-4 py-3 font-semibold {{ app.request.pathInfo == path('organizer_dashboard') ? 'bg-white/10' : '' }}">Tableau de bord</a>
            <a href="{{ path('events') }}" class="block rounded-xl px-4 py-3 text-olympia-sable hover:bg-white/10">Voir les événements</a>
            <a href="{{ path('organizer_event_new') }}" class="block rounded-xl px-4 py-3 text-olympia-sable hover:bg-white/10">Créer un événement</a>
            <a href="{{ path('organizer_categories') }}" class="block rounded-xl px-4 py-3 text-olympia-sable hover:bg-white/10">Configurer les catégories</a>
            <a href="{{ path('organizer_scan') }}" class="block rounded-xl px-4 py-3 text-olympia-sable hover:bg-white/10">Scan des billets</a>
        </nav>
        <div class="mt-8 border-t border-white/10 pt-5">
            {% set current_user = ticketika_current_user() %}
            {% if current_user %}<p class="px-3 text-xs text-olympia-sable">{{ current_user.fullName }}</p>{% endif %}
            <form method="post" action="{{ path('logout') }}" class="mt-3 px-3">
                <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="text-sm font-semibold text-olympia-sable underline-offset-4 hover:text-white hover:underline">Se déconnecter</button>
            </form>
        </div>
    </aside>
    <div class="min-w-0">{% block organizer %}{% endblock %}</div>
</div>
{% endblock %}
